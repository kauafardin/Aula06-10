{
  "version": 1,
  "author": "IoT AMF 2026-02",
  "editor": "wokwi",
  "serialMonitor": { "display": "always", "newLine": "lf" },
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-dht22", "id": "dht1", "top": -89, "left": 220, "attrs": {} },
    { "type": "wokwi-led", "id": "led1", "top": 120, "left": 236, "attrs": { "color": "red" } },
    { "type": "wokwi-resistor", "id": "r1", "top": 195, "left": 230, "attrs": { "value": "220" } }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],

    [ "dht1:VCC", "esp:3V3", "red", [ "v0" ] ],
    [ "dht1:GND", "esp:GND.1", "black", [ "v0" ] ],
    [ "dht1:SDA", "esp:D4", "green", [ "v0" ] ],

    [ "esp:D2", "r1:1", "green", [ "v0" ] ],
    [ "r1:2", "led1:A", "green", [ "v0" ] ],
    [ "led1:C", "esp:GND.2", "black", [ "v0" ] ]
  ],
  "dependencies": {}
}
